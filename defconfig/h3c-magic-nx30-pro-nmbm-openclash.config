# Official ImmortalWrt openwrt-24.10 build configuration for
# H3C Magic NX30 Pro with Hanwckf FIP / NMBM layout.
# The three Wi-Fi packages are the device's required driver/firmware stack;
# OpenClash needs the legacy CBI datatype module supplied by luci-compat.
# Keep it explicitly installed: the in-plugin updater may otherwise prune an
# auto-installed luci-compat package and break LuCI on ImmortalWrt 24.10.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_h3c_magic-nx30-pro-nmbm=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-openclash=y
